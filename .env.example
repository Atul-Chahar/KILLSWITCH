# Copy to .env and fill in. NEVER commit .env.
AWS_REGION=ap-south-1
AWS_SECONDARY_REGION=us-east-1

# Demo account guardrails
DEMO_ACCOUNT_ID=
DEMO_BUDGET_ALARM_EMAIL=

# GitHub webhook
GITHUB_WEBHOOK_SECRET=
GITHUB_APP_TOKEN=
GITHUB_DEMO_REPO=owner/private-demo-repo

# Bedrock. Required when NARRATOR_MODE is empty or "bedrock": narrate/agent.py
# refuses to run without it rather than quietly asking whichever model the SDK
# happens to default to. Leave blank if you are using NARRATOR_MODE=nim.
BEDROCK_MODEL_ID=

# Which narrator writes the plan:
#   empty / "bedrock"  ask a model on Amazon Bedrock            (needs BEDROCK_MODEL_ID)
#   "nim"              ask a model on NVIDIA NIM                (needs NVIDIA_API_KEY)
#   "rehearsal"        a fixed plan, no model and no network at all
# The rehearsal plan always includes one action the verifier rejects, which is what
# makes the guardrail filmable without waiting for a model to misbehave.
NARRATOR_MODE=

# NVIDIA NIM. Only read when NARRATOR_MODE=nim. The key is an nvapi-… value from
# build.nvidia.com. NEVER commit it — .env is gitignored, keep it that way.
# List the ids your key can actually reach before trusting one:
#   curl -s https://integrate.api.nvidia.com/v1/models \
#     -H "Authorization: Bearer $NVIDIA_API_KEY" | jq -r '.data[].id'
NVIDIA_API_KEY=
NIM_MODEL_ID=

# Resource names (filled by CDK outputs)
INCIDENT_TABLE_NAME=
STATE_MACHINE_ARN=
VERIFIED_PERMISSIONS_POLICY_STORE_ID=
