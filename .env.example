# Copy to .env and fill in. NEVER commit .env.
AWS_REGION=ap-south-1
AWS_SECONDARY_REGION=us-east-1

# Demo account guardrails
DEMO_ACCOUNT_ID=
DEMO_BUDGET_ALARM_EMAIL=

# GitHub webhook
GITHUB_WEBHOOK_SECRET=
GITHUB_APP_TOKEN=
GITHUB_DEMO_REPO=owner/private-demo-repo

# Bedrock. Required: narrate/agent.py refuses to run without it rather than
# quietly asking whichever model the SDK happens to default to.
BEDROCK_MODEL_ID=

# Which narrator writes the plan. Empty or "bedrock" asks the model. "rehearsal" uses a
# fixed plan that always includes one action the verifier rejects, for filming the
# guardrail and for rehearsing the console without Bedrock.
NARRATOR_MODE=

# Resource names (filled by CDK outputs)
INCIDENT_TABLE_NAME=
STATE_MACHINE_ARN=
VERIFIED_PERMISSIONS_POLICY_STORE_ID=
