{
  "StartAt": "Investigate",
  "States": {
    "Investigate": {
      "Next": "HasTheEvidenceLanded",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ClientExecutionTimeoutException",
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 6,
          "BackoffRate": 2
        }
      ],
      "Type": "Task",
      "Resource": "<redacted-arn>"
    },
    "WaitForEvidence": {
      "Type": "Wait",
      "Seconds": 60,
      "Next": "Investigate"
    },
    "HasTheEvidenceLanded": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.evidence_settled",
          "BooleanEquals": true,
          "Next": "Narrate"
        }
      ],
      "Default": "WaitForEvidence"
    },
    "Narrate": {
      "Next": "Verify",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ClientExecutionTimeoutException",
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 6,
          "BackoffRate": 2
        }
      ],
      "Type": "Task",
      "Resource": "<redacted-arn>"
    },
    "Verify": {
      "Next": "Authorize",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ClientExecutionTimeoutException",
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 6,
          "BackoffRate": 2
        }
      ],
      "Type": "Task",
      "Resource": "<redacted-arn>"
    },
    "Authorize": {
      "Next": "WaitForHumanApproval",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ClientExecutionTimeoutException",
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 6,
          "BackoffRate": 2
        }
      ],
      "Type": "Task",
      "Resource": "<redacted-arn>"
    },
    "WaitForHumanApproval": {
      "Next": "Contain",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ClientExecutionTimeoutException",
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 6,
          "BackoffRate": 2
        }
      ],
      "Type": "Task",
      "TimeoutSeconds": 3600,
      "ResultPath": "$.approval",
      "Resource": "arn:<redacted-arn>:states:::lambda:invoke.waitForTaskToken",
      "Parameters": {
        "FunctionName": "<redacted-arn>",
        "Payload": {
          "incident_id.$": "$.incident_id",
          "blast_radius.$": "$.blast_radius",
          "verification.$": "$.verification",
          "tiers.$": "$.tiers",
          "summary.$": "$.summary",
          "narrator.$": "$.narrator",
          "task_token.$": "$$.Task.Token"
        }
      }
    },
    "Contain": {
      "Next": "ConfirmEndState",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ClientExecutionTimeoutException",
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 6,
          "BackoffRate": 2
        }
      ],
      "Type": "Task",
      "Resource": "<redacted-arn>"
    },
    "ConfirmEndState": {
      "Next": "HowDidItEnd",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ClientExecutionTimeoutException",
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 6,
          "BackoffRate": 2
        }
      ],
      "Type": "Task",
      "Resource": "<redacted-arn>"
    },
    "HowDidItEnd": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.status",
          "StringEquals": "contained",
          "Next": "Contained"
        },
        {
          "Variable": "$.status",
          "StringEquals": "declined",
          "Next": "DeclinedByOperator"
        }
      ],
      "Default": "ContainmentUnconfirmed"
    },
    "ContainmentUnconfirmed": {
      "Type": "Fail",
      "Error": "ContainmentUnconfirmed",
      "Cause": "AWS did not confirm the expected end state for every action"
    },
    "Contained": {
      "Type": "Succeed"
    },
    "DeclinedByOperator": {
      "Type": "Succeed"
    }
  },
  "TimeoutSeconds": 7200
}
